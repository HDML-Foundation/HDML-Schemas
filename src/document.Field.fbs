include "./enum.AggregationType.fbs";
include "./enum.DataType.fbs";
include "./enum.DecimalBitWidth.fbs";
include "./enum.DateUnit.fbs";
include "./enum.OrderType.fbs";
include "./enum.TimeUnit.fbs";
include "./enum.TimeZone.fbs";

namespace document;

/// Unspecified data type parameters structure.
table UnspecifiedParametersStruct {}

/// Common data type parameters structure.
table CommonParametersStruct {
  nullable: bool;
}

/// Decimal data type parameters structure.
table DecimalParametersStruct {
  nullable: bool;
  scale: ushort;
  precision: ushort;
  bit_width: enum.DecimalBitWidthEnum;
}

/// Date data type parameters structure.
table DateParametersStruct {
  nullable: bool;
  unit: enum.DateUnitEnum;
}

/// Time data type parameters structure.
table TimeParametersStruct {
  nullable: bool;
  unit: enum.TimeUnitEnum;
}

/// Timestamp data type parameters structure.
table TimestampParametersStruct {
  nullable: bool;
  unit: enum.TimeUnitEnum;
  timezone: enum.TimeZoneEnum;
}

/// Data type options.
union DataTypeOptionsStruct {
  UnspecifiedParametersStruct,
  CommonParametersStruct,
  DecimalParametersStruct,
  DateParametersStruct,
  TimeParametersStruct,
  TimestampParametersStruct,
}

/// Field type structure.
table FieldTypeStruct {
  type: enum.DataTypeEnum;
  options: DataTypeOptionsStruct;
}

/// Data field structure.
table FieldStruct {
  name: string;
  description: string;
  origin: string;
  clause: string;
  type: FieldTypeStruct;
  aggregation: enum.AggregationTypeEnum;
  order: enum.OrderTypeEnum;
  /// The named key group this field belongs to, e.g. `pk` or
  /// `natural`. A NAMED group rather than a `bool` because a key
  /// is a set: a `bool` cannot tell a field that is one column of
  /// a composite primary key from one that is an alternate unique
  /// key on its own, and that is exactly the distinction the
  /// fan-out detector this field exists for needs in order not to
  /// flag a safe join (RFC 019/001 §4.4). An unknown group name is
  /// free-form, not an error -- the vocabulary does not enumerate
  /// key names.
  ///
  /// Nothing reads it yet. The fan-out detector is a later
  /// project; 019 puts the field in the schema so that project is
  /// possible (RFC 019/001 §4.8), and the Go binding is not
  /// regenerated until step 22 (§4.6).
  ///
  /// Its one rule lives in the PARSER, not here: `key` is
  /// meaningful only on an `<hdml-field>` whose parent is
  /// `<hdml-dataset>`, and in the other four positions it is
  /// reported as a `misplaced-key` warning and ignored. That is
  /// where the field's parent is known (RFC 019/001 §4.7).
  key: string;
}
